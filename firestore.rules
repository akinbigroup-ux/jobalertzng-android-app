rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /subscribers/{userId} {
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['token', 'updatedAt', 'platform'])
        && request.resource.data.keys().hasAll(['token', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 50
        && request.resource.data.token.size() < 5000;
      allow read, delete: if false;
    }
    match /appState/{document=**} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
